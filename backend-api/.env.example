# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
FRONTEND_URL=http://localhost:3001
LOGO_URL=https://mototrad.com/assets/dist/img/mototrad-logo-cropped.jpg

# Database
# Local PostgreSQL
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/mototrad?schema=public"

# AWS RDS PostgreSQL (Production Fallback)
DATABASE_URL_PROD="postgresql://mototrad_admin:password@host:5432/db?schema=public&sslmode=require"

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_here
JWT_EXPIRATION=1d

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=mototrad-assets

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Email / SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# PayPal Integration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Membership
MEMBERSHIP_FEE=5.00
